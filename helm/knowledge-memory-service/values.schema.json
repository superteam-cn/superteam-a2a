{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "knowledge-memory-service values schema",
  "type": "object",
  "description": "Phase 2 §2.2/§2.3 schema enum + 交叉验证：leaderElection.backend=k8s 时 replicaCount>=2；replicaCount==1 时强制 in_process。",
  "additionalProperties": false,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "description": "Phase 1 ADR-0006 D 方案单进程强制 == 1。Phase 2 k8s leader election 模式下需 >= 2。",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "tag": { "type": "string" }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "targetPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": { "type": "array" },
        "tls": { "type": "array" }
      }
    },
    "resources": { "type": "object" },
    "livenessProbe": { "type": "object" },
    "readinessProbe": { "type": "object" },
    "leaderElection": {
      "type": "object",
      "additionalProperties": false,
      "description": "Phase 2 §2.2/§2.3 · default in_process（ADR-0006 D 方案）· k8s opt-in 需配合 replicaCount>=2",
      "properties": {
        "backend": {
          "type": "string",
          "enum": ["in_process", "k8s"],
          "description": "in_process: Phase 1 MVP 默认单进程 · k8s: Phase 2 spike 多副本 leader election"
        }
      },
      "required": ["backend"]
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "description": "L4-Phase3 PR-2 · MemoryBackend implementation 选择。default in_process（Phase 1 MVP），k8s opt-in 启用生产 CustomObjectsApi 后端。",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["in_process", "k8s"],
          "description": "MemoryBackend 类型：in_process = dict-backed（默认），k8s = CustomObjectsApi-backed 生产后端"
        },
        "k8s": {
          "type": "object",
          "additionalProperties": false,
          "description": "仅 backend.type=k8s 时生效 · CustomObjectsApi 配置",
          "properties": {
            "crdGroup": {
              "type": "string",
              "description": "Memory CRD apiGroup（默认 memory.superteam-a2a.io）"
            },
            "crdVersion": {
              "type": "string",
              "description": "Memory CRD apiVersion（默认 v1alpha1）"
            },
            "crdPlural": {
              "type": "string",
              "description": "Memory CRD plural name（默认 memories）"
            },
            "listTimeoutSeconds": {
              "type": "number",
              "minimum": 1,
              "maximum": 600,
              "description": "K8sBackend list query timeout (seconds) · plan §3.5"
            }
          }
        }
      },
      "required": ["type"]
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logLevel": {
          "type": "string",
          "enum": ["DEBUG", "INFO", "WARNING", "ERROR"]
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "secretName": { "type": "string" }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "scrapeTimeout": { "type": "string" }
      }
    },
    "prometheusRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "annotations": { "type": "object" }
  },
  "required": ["replicaCount", "leaderElection"]
}